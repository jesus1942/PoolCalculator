DATABASE_URL="postgresql://usuario:password@localhost:5432/pool_calculator?schema=public"
JWT_SECRET="tu_super_secreto_jwt_cambiar_en_produccion"
PORT=3000
NODE_ENV=development
UPLOAD_DIR=uploads
REMINDER_EMAIL_INTERVAL_MS=300000
REMINDER_EMAIL_BATCH=50
REMINDER_EMAIL_LOOKBACK_MS=86400000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Orígenes exactos permitidos, separados por coma; incluye tu dominio al publicarlo.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Clave AES-256 dedicada de 64 caracteres hexadecimales.
# Generar UNA vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Conservar junto con los backups. Cambiarla sin migrar deja ilegibles las credenciales guardadas.
INTEGRATIONS_ENCRYPTION_KEY=

# Compatibilidad inicial: se pueden cargar después desde Configuración > Integraciones.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
